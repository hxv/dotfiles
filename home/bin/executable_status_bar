#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit

SELF=$(basename "$0")
DIR=$(dirname "$0")

export color_good='#DDDDDD'
export color_degraded='#AE8ABE'
export color_bad='#FF6B68'

n=0

i3status | while IFS= read -r line; do
    if [[ $n == 0 || $n == 1 ]]; then
        echo "$line"

        n=$(( n + 1 ))

        continue
    fi

    if [[ "${line:0:1}" == "," ]]; then
        line="${line:1}"
    fi

    elements=$(jq -c -M '.[]' <<< "$line")
    mapfile -t parsed <<< "$elements"

    buffer=''

    for part in "${parsed[@]}"; do
        [[ -z "$part" ]] && continue

        if [[ "$part" =~ placeholder_([^\"]+) ]]; then
            script="${BASH_REMATCH[1]}"
            export script

            result=$("$DIR/$SELF.d/$script" || true)

            [[ -z "$result" ]] && continue

            if [[ "${result:0:1}" != "{" ]]; then
                result=$(jq -n -M -c '{full_text: $text}' --arg text "$result")
            fi

            buffer+=$(jq -c -M '{full_text: .full_text, instance: env.script, name: env.script, markup: "none", color: .color}' <<< "$result")
            buffer+=','
        else
            buffer+="$part,"
        fi
    done

    echo "[${buffer%,}],"
done
