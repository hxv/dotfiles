#!/usr/bin/env php
<?php
// Tła TrueColor wyciągnięte z Twoich kodów (RGB: #002800 i #3f0001)
$bg_green   = "\e[48;2;0;40;0m";
$bg_red     = "\e[48;2;63;0;1m";
$bce        = "\e[0K";
$reset      = "\e[0m";

// Kody ANSI z Twojego logu
$gutter_end = "\e[34m│\e[0m"; // Niebieska kreska panelu
$color_old  = "\e[38;5;88m";    // Ciemnoczerwony numer (usunięte)
$color_new  = "\e[38;5;28m";    // Ciemnozielony numer (dodane)

// Czytamy strumień wejścia linijka po linijce
while (($line = fgets(STDIN)) !== false) {
    $line = rtrim($line, "\r\n");

    // Jeśli linia kończy się na niebieskiej kresce, znaczy że dalej nie ma tekstu (jest pusta)
    if (str_ends_with($line, $gutter_end)) {
        $has_old = str_contains($line, $color_old);
        $has_new = str_contains($line, $color_new);

        if ($has_new && !$has_old) {
            // Pusta linia dodana
            $line .= $bg_green . $bce . $reset;
        } elseif ($has_old && !$has_new) {
            // Pusta linia usunięta
            $line .= $bg_red . $bce . $reset;
        }
    }

    echo $line . PHP_EOL;
}
