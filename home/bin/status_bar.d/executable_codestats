#!/usr/bin/env bash

username=hxv
cache_file="/tmp/i3-code-stats-$username"

find "$cache_file" -mmin +3 -type f -delete 2>/dev/null
if [[ ! -f "$cache_file" ]]; then
    curl -s -m 15 "https://codestats.net/api/users/$username" \
       | jq -M -c '{full_text: (" " + (.new_xp|tostring) + " xp / " + (0.025*(.total_xp|sqrt)|floor|tostring) + " lvl")}' \
        > "$cache_file"
fi

cat "$cache_file"
